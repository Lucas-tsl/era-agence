# Sanity (laisser vide tant que le projet n'est pas créé : le contenu de secours est utilisé)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Secret partagé avec le webhook Sanity (/api/revalidate)
SANITY_REVALIDATE_SECRET=

# URL publique du site (sitemap, balises Open Graph). Sur Vercel, déduite automatiquement si vide.
NEXT_PUBLIC_SITE_URL=

# Formulaire de contact (optionnel, via Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@era-agence.com
CONTACT_FROM_EMAIL=Site ERA <site@era-agence.com>
